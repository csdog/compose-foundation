  "html": "<html lang=\"en\" style=\"color-scheme: light; overflow-y: scroll;\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <script>\n        // Document positions belong to the Compose route cache, including browser Back/Forward.\n        history.scrollRestoration = \"manual\";\n    </script>\n    <title>Compose Foundation — Components</title>\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg?v=kotlin-gradient\">\n    <link type=\"text/css\" rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body style=\"text-align: center; align-content: center; height: calc(4593px + 100vh);\">\n    <div id=\"compose-root\"><div style=\"position: relative;\"><div style=\"position: relative;\"></div><div style=\"position: absolute; top: 0px; left: 0px;\"></div></div></div>\n    <script type=\"application/javascript\" src=\"webApp.js\"></script>\n\n\n</body></html>",
